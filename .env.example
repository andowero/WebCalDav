# Logging verbosity: DEBUG / INFO / WARNING / ERROR.
#LOG_LEVEL=INFO

# Idle session timeout in seconds.
#SESSION_IDLE_TIMEOUT=3600

# Reject CalDAV server URLs resolving to private/loopback/link-local/metadata
# addresses (SSRF guard). Set false if your CalDAV server runs on a private/LAN IP.
#BLOCK_PRIVATE_CALDAV_URLS=false

# Secure flag on the session cookie. Leave true behind a TLS-terminating proxy;
# set false only for plain-HTTP access from non-localhost addresses.
#COOKIE_SECURE=true

# Per-IP login throttle: at most ATTEMPTS requests per WINDOW seconds (0 disables).
#LOGIN_RATE_LIMIT_ATTEMPTS=5
#LOGIN_RATE_LIMIT_WINDOW_SECONDS=300

# Minimum length for passwords set on first login / password change.
#MIN_PASSWORD_LENGTH=12

# Argon2id parameters (production defaults — do not weaken).
#ARGON2_TIME_COST=3
#ARGON2_MEMORY_COST=131072
#ARGON2_PARALLELISM=1

# How many days ahead the notification scheduler loads events to fire reminders.
#NOTIFICATION_HORIZON_DAYS=60

# How many days behind now it also loads, so reminders anchored *after* an event
# that has already ended still fire. Defaults to the horizon.
#NOTIFICATION_LOOKBACK_DAYS=60

# Enable the MCP server at /mcp so AI assistants can read/write calendars via an
# API token (see MCP.md). Off by default. When off, /mcp is not mounted and new
# tokens cannot be created (existing tokens can still be revoked). Note: an API
# token can decrypt the user's CalDAV credentials, so enable this deliberately.
#MCP_SERVER_ENABLED=false

# Calendar sharing: let users create share links (single item, grid period,
# agenda slice) and .ics downloads (see SHARING.md). On by default. When off,
# new links cannot be created (existing ones can still be listed and revoked).
# A share link can decrypt the user's CalDAV credentials, same as an API token.
#SHARING_ENABLED=true

# External origin used to build share links, e.g.
# https://calendar.zdeneknovak.one. When unset it is derived from the reverse
# proxy's X-Forwarded-Proto / X-Forwarded-Host headers. Set it if those are
# unreliable.
#PUBLIC_BASE_URL=
